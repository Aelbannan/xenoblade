{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.0/schema.json",
  "permissionGate": {
    "autoDenyPatterns": [
      {
        "pattern": "git reset"
      },
      {
        "pattern": "git push"
      },
      {
        "pattern": "git clean"
      },
      {
        "pattern": "git checkout"
      },
      {
        "pattern": "git restore"
      },
      {
        "pattern": "git stash"
      },
      {
        "pattern": "git filter-branch"
      },
      {
        "pattern": "git filter-repo"
      }
    ]
  },
  "version": "0.17.0"
}
