{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.0/schema.json",
  "permissionGate": {
    "autoDenyPatterns": [
      {
        "pattern": "(?:\\bgit\\b(?:\\s+-C\\s+\\S+)*(?:\\s+--?[\\w-]+(?:=\\S*)?)*\\s+(?:reset|push|clean|checkout|restore|stash|filter-branch|filter-repo)\\b)|(?:\\[\\s*['\\\"]git['\\\"]\\s*,\\s*['\\\"](?:reset|push|clean|checkout|restore|stash|filter-branch|filter-repo)['\\\"])",
        "regex": true,
        "description": "Blocked: destructive/rewriting git command (reset/push/clean/checkout/restore/stash/filter-branch/filter-repo), including -C/flag forms and Python argv ['git','<verb>']"
      }
    ]
  },
  "version": "0.17.0"
}
