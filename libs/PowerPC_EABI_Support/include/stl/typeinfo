#ifndef MSL_CPP_TYPEINFO_H
#define MSL_CPP_TYPEINFO_H

#include <exception>

namespace std{
    // MetroWerks RTTI locators are {const char* name, base-list} pairs in
    // .sdata; name() reads word 0 directly.
    class type_info {
    public:
        const char* name() const { return mName; }
    private:
        const char* mName;
    };

    class bad_cast : public exception {
    public:
        virtual ~bad_cast(){}
        virtual const char* what() const{
            return "bad_cast";
        }
    };

    class bad_typeid : public exception {
    public:
        virtual ~bad_typeid(){}
        virtual const char* what() const{
            return "bad_typeid";
        }
    };
}

#endif
