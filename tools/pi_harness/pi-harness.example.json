{
  "matchModel": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-v4-flash",
    "thinkingLevel": "low"
  },
  "cleanupModel": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-v4-flash",
    "thinkingLevel": "high"
  },
  "batchSize": 5,
  "maxParallelTUs": 3,
  "maxBatchRetries": 1,
  "singletonEnabled": true,
  "rebatchEnabled": true,
  "maxRebatchAttempts": 0,
  "maxTokens": 0,
  "singletonMinSize": 500,
  "maxBriefChars": 80000,
  "maxBatchMinutes": 45,
  "region": "us",
  "sessionDir": "build/pi-harness/sessions",
  "ledgerPath": "build/pi-harness/ledger.jsonl",
  "timeoutRetries": 3,
  "silenceThresholdSec": 0, // seconds of model silence before abort; 0 = auto
  "emptyRoundRetries": 2, // re-run a 429-empty round (no assistant output) up to N times
  "roundStartJitterMs": 15000, // random 0..N ms delay before each round start (spreads concurrency burst)
  "rpmLimit": 0, // global cross-session request throttle (req/min). 0 = off (SDK auto-retry stays on). >0 paces ALL HTTP requests + disables SDK auto-retry (harness owns backoff). nube DeepSeek cap is ~20; set 18-20 for multi-session runs.
  "rejectionRetries": 1,
  "tuFinalAttempts": 2,
  "tuFinalTimeoutMinutes": 0,
  "briefTargetChars": 12000,
  "costModel": {
    "inputPerM": 0.14,
    "outputPerM": 0.28,
    "cacheReadPerM": 0.0028,
    "cacheWritePerM": 0.0
  },
  "knownWallsPath": "docs/KNOWN_WALLS.md",
  "nearmissDir": "build/pi-harness/nearmiss",
  "maxAttemptsPerTarget": 4,
  "staleRoundThreshold": 2,
  "retryExhausted": false,
  "greenfieldOnly": false,
  "bankOnlyOnBetter": true,
  "selection": "claim-order",
  "triage": "off",
  "pythonBin": ".venv/bin/python",
  "singletonModel": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-v4-flash",
    "thinkingLevel": "high"
  },
  "rebatchModel": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-v4-flash",
    "thinkingLevel": "high"
  },
  "maxSingletonSessions": 1,
  "snapshotsEnabled": true,
  "witnessEnabled": true,
  "exhaustionThreshold": 3,
  "commitOnTuFinal": false
}